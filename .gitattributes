# Enforce line endings explicitly -- independent of the local core.autocrlf setting.
#
# Files that are executed on Linux must NEVER be checked out with CRLF: the shell does not
# treat \r as a line terminator but as part of the last argument on the line.

# Default: let Git decide what is text and normalize to LF inside the repository.
* text=auto

# --- Must be LF (runs on Linux) ---
*.sh          text eol=lf
*.bash        text eol=lf
*.zsh         text eol=lf
Dockerfile    text eol=lf
*.dockerfile  text eol=lf
.dockerignore text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.service     text eol=lf
*.timer       text eol=lf
*.conf        text eol=lf
.env*         text eol=lf
Makefile      text eol=lf

# --- Must be CRLF (Windows interpreters) ---
*.bat text eol=crlf
*.cmd text eol=crlf

# --- Binary: never touch ---
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.dll  binary
*.exe  binary
*.pfx  binary
*.snk  binary
